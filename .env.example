# Application URL (auto-injected in AI Studio, or your Render/local URL)
APP_URL="http://localhost:3000"

# MongoDB Atlas Connection String (required for Registered Mode & Leaderboard)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/echoes_of_the_dark?retryWrites=true&w=majority"

# JWT Signing Secret (use a long random string in production)
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_SECRET"
JWT_EXPIRES_IN="7d"

# Comma-separated CORS allowlist for standalone backend deployment
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Server-side Gemini API key & model (never exposed to browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

